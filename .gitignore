# Dependencies
node_modules/
.pnpm-store/

# Build & Compilation Outputs
.next/
out/
dist/
build/
bin/
obj/

# Environment & Secrets (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cer
*.crt
credentials.json
secrets.json

# Temporary Files & Customer Documents (Privacy & Security)
tmp/
temp/
downloads/
*.pdf
*.doc
*.docx
*.jpg
*.jpeg
*.png

# Database & Storage
*.sqlite
*.db
*.dump
*.sql

# Prisma migrations are source code, not database dumps. Without this negation
# the *.sql rule above silently excludes them and `prisma migrate deploy` finds
# nothing to apply in production.
!**/prisma/migrations/**/*.sql

# Graphify Knowledge Graph Artifacts
graphify-out/
.claude/

# Installed agent skills and their lockfile (security-audit and friends).
# Vendored tooling, not this project's source: `npx skills add` re-fetches it,
# and skills-lock.json pins the hash it was fetched at.
.agents/
skills-lock.json

# Security audit output, for the case where a run is pointed at the repo rather
# than its default home outside it (~/security-audit-skill/<repo>/run-N). The
# reports name unfixed findings with file:line, so they never get committed.
# Directories only, deliberately: the skill's own artifact names are generic
# (findings.json, run-metadata.json) and ignoring those by bare name would
# silently swallow an unrelated file later. Point a run somewhere new and add
# that directory here.
security-audit-skill/
security-audit-out/


# OS & Editor Files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

# Testing & Coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Consolidated status and security findings, and the commercial model. Kept out
# of git so they can name findings, hosts, a competitor's figures and
# unfinalised prices freely.
STATUS.md
PRICING.md

# Local database exports (may contain customer data)
backups/

# Personal action list: environments, accounts and dashboards only you can set up.
# Kept out of git so it can name services and steps freely.
taskFyou.prd


# Agent build output staged for the installer.
agent/dist/

