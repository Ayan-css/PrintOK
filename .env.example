# Environment Baseline for PrintOk (Development)

# Server API Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL=postgresql://printok_user:printok_pass@localhost:5432/printok_db?schema=public
# Direct/session connection used ONLY by Prisma Migrate. Required when DATABASE_URL
# is a transaction pooler (e.g. Supabase port 6543): migrations take a session-level
# advisory lock that a transaction pooler does not support, so they hang rather than
# fail. Point this at the session/direct port (Supabase: 5432, no pgbouncer=true).
DIRECT_URL=postgresql://printok_user:printok_pass@localhost:5432/printok_db?schema=public

# S3-Compatible Temporary Object Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=printok-temp-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# JWT / Security Configuration
JWT_SECRET=change_this_to_a_secure_random_string_in_production
AGENT_PAIRING_SECRET=change_this_pairing_secret_in_production

# Print Agent Configuration
PRINT_AGENT_ID=agent-dev-001
PRINT_AGENT_POLL_INTERVAL_MS=3000
PRINT_AGENT_REPO=Ayan-css/PrintOK
AGENT_INSTALLER_URL=https://github.com/Ayan-css/PrintOK/releases/download/latest/WindowsPrintAgent.exe

# Payment Gateway Configuration (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=printok_webhook_secret_dev
# Paid plans (Razorpay Dashboard > Subscriptions > Plans, monthly). Unset = paid
# plans are refused in production and applied without billing in development.
# RAZORPAY_PLAN_ID_STARTER=plan_xxx
# RAZORPAY_PLAN_ID_BUSINESS=plan_xxx
# RAZORPAY_PLAN_ID_PRO=plan_xxx

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Without these the platform cannot send anything: contact enquiries are stored
# and reach nobody, and a shop owner who forgets their password has no way back
# into their account. GET /api/admin/email-status reports which of these are
# missing and what it costs.
#
# EMAIL_PROVIDER: "brevo" or "resend" to send for real, "log" to print messages
# to the console in development. "log" is ignored in production, because an
# operator who believes mail works is worse off than one who knows it does not.
#
# Which of the two depends on whether you own a domain:
#
#   brevo  — sends from a single address you confirm by clicking a link emailed
#            to it. Needs NO domain, so it is the one that works before there is
#            one to verify. Deliverability from a @gmail.com sender is worse
#            than from your own domain, because SPF and DKIM align to Brevo
#            rather than to the sender; at password-reset volumes that means the
#            occasional spam folder, not failure.
#
#   resend — sends only from a domain verified by DNS. Better deliverability,
#            and the right answer once you own one. Its no-domain address
#            (onboarding@resend.dev) delivers solely to your own signup inbox,
#            which is useless for resetting a shop owner's password.
#
# Moving between them is these two variables and nothing else. No code change.
EMAIL_PROVIDER=log
# The provider's API key. Required for brevo and resend alike.
# Brevo: SMTP & API -> API Keys. Resend: API Keys. Both show it once.
EMAIL_API_KEY=
# The From address. "Name <address>" is parsed into the halves Brevo wants and
# passed whole to Resend, so one spelling works for both.
#
# Brevo: any single address you have verified (a Gmail address is fine).
# Resend: an address on a domain you have verified by DNS.
EMAIL_FROM=PrintOk <noreply@yourdomain.in>
# Where contact enquiries are delivered.
OPERATOR_EMAIL=

# ---------------------------------------------------------------------------
# Document retention
# ---------------------------------------------------------------------------
# A document is deleted the moment it prints. These two windows only cover the
# documents that never get there, and they are deliberately different: one
# global window short enough to be honest about abandoned uploads would also
# destroy paid jobs a shop simply has not printed yet.
#
# Unpaid: someone uploaded, saw the price and left. Nothing is owed either way.
DOCUMENT_RETENTION_UNPAID_MINUTES=120
# Paid but still unprinted: the customer is owed either paper or a refund, so
# this window has to outlast a closed shop, a weekend and a jammed printer.
DOCUMENT_RETENTION_PAID_HOURS=168

# ---------------------------------------------------------------------------
# Razorpay Route (automatic settlement)
# ---------------------------------------------------------------------------
# Leave this unset until Razorpay has activated Route on the account AND a
# Linked Account has been created and tested end to end. When on, the shop's
# share of each captured payment is transferred to its activated linked
# account, held until the job prints, and reversed if the order is refunded.
# Shops without an activated linked account keep settling to PrintOk.
# RAZORPAY_ROUTE_ENABLED=true
#
# Linked-account profile category. Defaults to Razorpay's published
# services / copying_and_blueprinting_services; override only if Razorpay asks.
# RAZORPAY_ROUTE_CATEGORY=services
# RAZORPAY_ROUTE_SUBCATEGORY=copying_and_blueprinting_services

# With NODE_ENV=production the API takes payments only with a live key
# (rzp_live_). Set this to true ONLY on a staging deployment that runs
# NODE_ENV=production with rzp_test_ keys on purpose.
# RAZORPAY_ALLOW_TEST_KEYS=true

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Requests per minute per IP. The auth limiter covers login, claim, bootstrap
# and pairing, and only counts failures, so a shop owner typing their own
# password correctly is never locked out.
AUTH_RATE_LIMIT_PER_MINUTE=5
API_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Web origins
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API. In production this
# must be set: without it the API accepts browser requests from anywhere.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Where the customer-facing site lives. Used to build links in emails, which
# are useless if they point at localhost.
PUBLIC_WEB_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Background work
# ---------------------------------------------------------------------------
# How often stale in-flight jobs are returned to the queue, in milliseconds.
RECLAIM_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# Migrations and deployment (rarely set by hand)
# ---------------------------------------------------------------------------
# Skips the migration step at boot. For a host that runs migrations as a
# separate release command; never as a way past a failing migration.
# PRINTOK_SKIP_MIGRATIONS=true
# Allows migrations to run against a non-local database from a developer
# machine. Off by default so a local `npm start` cannot migrate production.
# PRINTOK_ALLOW_REMOTE_MIGRATE=true
# Build identifier shown by the health endpoint. Render sets RENDER_GIT_COMMIT
# automatically; GIT_COMMIT is the manual equivalent elsewhere.
# GIT_COMMIT=
# Postgres database used by `npm run test:db`. Never a database with real data
# in it: the suite truncates tables.
# TEST_DATABASE_URL=postgresql://printok_user:printok_pass@localhost:5432/printok_test
