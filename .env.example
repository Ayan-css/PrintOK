# Environment Baseline for PrintOk (Development)

# Server API Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL=postgresql://printok_user:printok_pass@localhost:5432/printok_db?schema=public
# Direct/session connection used ONLY by Prisma Migrate. Required when DATABASE_URL
# is a transaction pooler (e.g. Supabase port 6543): migrations take a session-level
# advisory lock that a transaction pooler does not support, so they hang rather than
# fail. Point this at the session/direct port (Supabase: 5432, no pgbouncer=true).
DIRECT_URL=postgresql://printok_user:printok_pass@localhost:5432/printok_db?schema=public

# S3-Compatible Temporary Object Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_NAME=printok-temp-documents
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# JWT / Security Configuration
JWT_SECRET=change_this_to_a_secure_random_string_in_production
AGENT_PAIRING_SECRET=change_this_pairing_secret_in_production

# Print Agent Configuration
PRINT_AGENT_ID=agent-dev-001
PRINT_AGENT_POLL_INTERVAL_MS=3000
PRINT_AGENT_REPO=Ayan-css/PrintOK
AGENT_INSTALLER_URL=https://github.com/Ayan-css/PrintOK/releases/download/latest/WindowsPrintAgent.exe

# Payment Gateway Configuration (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=printok_webhook_secret_dev

