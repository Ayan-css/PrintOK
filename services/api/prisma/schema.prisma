// PrintOk production data model.
//
// Shaped by PRD sections 9 (job orchestration), 10 (payment/print state),
// 11 (idempotency) and 16 (shop pricing controls). The guiding rules:
//   * a job carries immutable snapshots of the config and price it was created
//     with, so replaying history never depends on mutable shop settings;
//   * payment state and print state are independent columns, never derived
//     from one another;
//   * every state change is appended to JobEvent rather than only mutating the
//     job row, so support and reconciliation have a durable trail.

datasource db {
  provider = "postgresql"

  // Pooled connection (Supabase transaction pooler, port 6543). Correct for the
  // application: many short-lived queries, no session state.
  url = env("DATABASE_URL")

  // Direct/session connection (port 5432) used only by Prisma Migrate.
  //
  // Migrations take a session-level advisory lock, which a transaction pooler
  // does not support - running them through port 6543 blocks forever rather
  // than failing, which is exactly how a deploy times out with "no open ports".
  // Falls back to DATABASE_URL when unset so local development still works.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Shop {
  id                String  @id
  name              String
  ownerEmail        String
  upiId             String?
  bankAccountNumber String?
  bankIfsc          String?
  payoutStatus      String  @default("active")

  // --- Contact & registered address ---
  /// Razorpay will not create a Route linked account without a phone number,
  /// and stalls KYC on an incomplete address.
  contactPhone      String?
  addressStreet1    String?
  addressStreet2    String?
  addressCity       String?
  addressState      String?
  addressPostalCode String?
  addressCountry    String? @default("IN")
  /// GST registration number, where the shop has one. Shape-checked only.
  gstin             String?

  /// Subscription tier: start | smart | business | enterprise (PRD 41).
  /// Canonical definitions live in PLAN_CATALOGUE in @printok/shared-types.
  planTier      String @default("start")
  /// PrintOk service fee in basis points (800 = 8.00%). Integer so money
  /// arithmetic stays exact. Defaults to the tier's published rate.
  commissionBps Int    @default(800)
  /// active | suspended | cancelled
  planStatus    String @default("active")

  // --- Razorpay Route (automatic split settlement) ---
  /// Linked account id (acc_...). Present once the shop is onboarded to Route.
  razorpayAccountId     String?
  /// not_linked | created | needs_kyc | activated | suspended
  razorpayAccountStatus String    @default("not_linked")
  razorpayLinkedAt      DateTime?
  /// Last error Razorpay returned, so a stuck onboarding is explainable.
  razorpayAccountError  String?

  /// Soft delete. An archived shop is hidden from normal listings but keeps its
  /// jobs and payment records, which is the only safe option once real money
  /// has moved through it.
  archivedAt    DateTime?
  archivedBy    String?
  archiveReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  printers     Printer[]
  jobs         PrintJob[]
  pricing      ShopPricing?
  rates        ShopRate[]
  portalConfig ShopPortalConfig?
  merchants    MerchantUser[]

  @@index([ownerEmail])
  @@index([archivedAt])
  @@index([razorpayAccountId])
}

/// Per-shop rate card. Previously computed from hardcoded constants, which made
/// the merchant "Rates Matrix" a no-op on the Postgres path. Rates are stored in
/// paise (integer cents) to keep money arithmetic exact.
model ShopPricing {
  shopId String @id
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  bwSinglePerPageCents    Int @default(200)
  bwDuplexPerPageCents    Int @default(150)
  colorSinglePerPageCents Int @default(1000)
  colorDuplexPerPageCents Int @default(800)

  /// Legacy. Superseded by ShopRate, which stores A3 as its own rate rather
  /// than deriving it. Kept so the compatibility facade on /api/shops/:id/pricing
  /// keeps answering, and so a rate card written before the grid is readable.
  a3Multiplier          Float @default(2.0)
  bulkDiscountThreshold Int   @default(50)
  bulkDiscountPercent   Int   @default(10)

  // --- Discounts (the grid's, not the legacy ones above) ---
  /// Lower per-page rates once an order's normal value crosses the threshold.
  bulkEnabled           Boolean @default(false)
  /// Order value in paise at which the bulk rates take over.
  bulkThresholdCents    Int     @default(10000)
  /// Copy 1 at the normal rate, copies 2+ at the per-configuration rate.
  additionalCopyEnabled Boolean @default(false)
  enableSeparatorPage   Boolean @default(false)
  separatorMinPages     Int     @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

/// What the customer portal asks for and offers, decided by the shop.
///
/// Separate from ShopPricing because this is about what the customer *sees*,
/// not what they are charged, and the two are configured on different screens.
/// One rate per print configuration.
///
/// Replaces four global rates plus an A3 multiplier, which could not express
/// "A3 colour costs the same as A4 colour" or "Letter is cheaper than A4" —
/// both of which are ordinary things for a shop to want.
model ShopRate {
  id     String @id
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  paperSize String
  isColor   Boolean
  isDuplex  Boolean

  perPageCents               Int
  /// Rate once the order clears the bulk threshold. Null means no discount for
  /// this configuration — distinct from a discounted rate that happens to be 0.
  bulkPerPageCents           Int?
  /// Rate for copies 2 and beyond. Null means they cost the same as copy 1.
  additionalCopyPerPageCents Int?

  /// Whether a customer may choose this combination at all.
  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([shopId, paperSize, isColor, isDuplex])
  @@index([shopId])
}

model ShopPortalConfig {
  shopId String @id
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  /// Whether the portal asks for a name, and whether it insists.
  /// Default false: a shop that has not opted in collects nothing, which is
  /// what its customers were promised.
  collectCustomerName   Boolean @default(false)
  customerNameRequired  Boolean @default(false)
  collectCustomerPhone  Boolean @default(false)
  customerPhoneRequired Boolean @default(false)

  /// Capability keys this shop offers, in the order it wants them shown.
  /// Empty means "the defaults" rather than "nothing" — a shop that has never
  /// opened the setup screen must still be able to sell.
  enabledServices String[] @default([])

  // --- Automation ---
  /// after-payment | all | off. Default preserves what PrintOk always did.
  autoPrintMode     String @default("after-payment")
  /// none | blank | invoice — a sheet printed between jobs on a busy counter.
  separatorMode     String @default("none")
  /// How many jobs waiting counts as a backlog worth separating.
  separatorMinQueue Int    @default(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Printer {
  id            String   @id
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  printerName   String
  qrTargetUrl   String
  qrCodeDataUrl String
  apiKey        String   @unique
  status        String   @default("online")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  jobs      PrintJob[]
  telemetry PrinterTelemetry?
  devices   AgentDevice[]

  @@index([shopId])
}

/// Agent liveness. Previously held in a process-local Map, so it was lost on every
/// API restart and wrong behind more than one instance.
model PrinterTelemetry {
  printerId String  @id
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  lastHeartbeat DateTime
  paperStatus   String   @default("OK")
  agentVersion  String?
  deviceId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([lastHeartbeat])
}

model PrintJob {
  id String @id

  /// Customer-facing order reference. Distinct from the internal job id so an
  /// order can later fan out to multiple jobs without changing customer links.
  orderId String @unique

  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  printerId String
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  /// Agent device that claimed the job. Null until assignment.
  deviceId String?

  /// Counter shown to the customer at the counter, e.g. "001".
  tokenNumber String?
  /// The day that counter belongs to, as YYYY-MM-DD.
  ///
  /// Tokens restart each morning, so "printer + token" is not unique on its
  /// own — #001 exists once a day. With the day it is, which is what lets the
  /// uniqueness be enforced by the database rather than argued about.
  tokenDay    String?

  // ---- Customer identity (optional, opt-in per shop) ----
  /// Only set when the shop has asked for it. The published privacy policy
  /// promises anonymity by default, and that holds for any shop that leaves
  /// collection off — see ShopPortalConfig.
  customerName  String?
  customerPhone String?

  // ---- Document reference ----
  fileName      String
  s3Key         String?
  fileUrl       String
  fileChecksum  String
  fileSizeBytes Int     @default(0)

  // ---- Immutable print configuration snapshot ----
  pageCount   Int
  copies      Int
  isColor     Boolean
  isDuplex    Boolean @default(false)
  paperSize   String  @default("A4")
  pageRange   String?
  /// auto | portrait | landscape. "auto" prints the document the way up it was
  /// written, which is what every job did before the customer could choose, so
  /// it is the default and every existing row reads back unchanged.
  orientation String  @default("auto")
  /// Frozen copy of the above as submitted, for audit and dispute resolution.
  printConfig Json?

  // ---- Immutable price snapshot ----
  totalPriceInCents Int
  /// The rate card and computed breakdown used at creation time, so a later
  /// change to ShopPricing can never alter what the customer was quoted.
  priceSnapshot     Json?

  // ---- Payment ----
  paymentState    String
  paymentProvider String?
  paymentRef      String?

  /// The gateway's own order id, distinct from `orderId` above — that one is
  /// PrintOk's customer-facing reference. Persisted so a browser-reported
  /// payment can be bound to the job the order was actually opened for.
  /// Without it the confirm endpoint had nothing to check a claimed payment
  /// against, and one real payment could mark any job at any shop as paid.
  razorpayOrderId          String?
  /// What the gateway order was opened for. Compared against the job total at
  /// confirmation, so a job whose price moved after the order was created
  /// cannot be settled at the older figure.
  razorpayOrderAmountCents Int?
  /// The gateway payment that settled this job. Unique across the platform, so
  /// the same payment cannot be replayed onto a second job — the database
  /// refuses it rather than the check having to be remembered.
  razorpayPaymentId        String? @unique

  // ---- Print lifecycle ----
  printState String

  // ---- Idempotency (PRD 11) ----
  /// Client-supplied key deduplicating repeated submissions of the same order.
  idempotencyKey String? @unique

  // ---- Retry metadata ----
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(3)
  lastAttemptAt DateTime?

  // ---- Failure classification (PRD 12) ----
  errorMessage    String?
  failureCategory String?

  // ---- Lifecycle timestamps ----
  queuedAt          DateTime?
  assignedAt        DateTime?
  printedAt         DateTime?
  completedAt       DateTime?
  /// Set when the stored document bytes were removed (PRD 15).
  documentDeletedAt DateTime?

  // --- Decline & refund ---
  /// Why the shop refused the job, shown to the customer.
  declineReason     String?
  /// Razorpay refund id (rfnd_...). A column rather than only an event, so a
  /// refund can be reconciled against Razorpay without replaying the log.
  refundId          String?
  refundAmountCents Int?
  refundedAt        DateTime?

  // --- Route settlement ---
  /// Razorpay transfer id (trf_...) for the shop's share of this payment.
  transferId          String?
  /// What the shop is owed from this order, after the PrintOk service fee.
  transferAmountCents Int?
  /// What PrintOk retained. Stored per job so payouts reconcile without
  /// recomputing against a commission rate that may have changed since.
  serviceFeeCents     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events JobEvent[]

  @@unique([printerId, tokenDay, tokenNumber])
  @@index([printerId, printState])
  @@index([shopId, createdAt])
  @@index([printState, createdAt])
  @@index([paymentRef])
  @@index([transferId])
  @@index([refundId])
}

/// Append-only lifecycle trail (PRD 9 and 22). One row per meaningful transition
/// or side effect; never updated or deleted alongside normal job mutation.
model JobEvent {
  id    String   @id @default(uuid())
  jobId String
  job   PrintJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// e.g. JOB_CREATED, PAYMENT_CONFIRMED, ASSIGNED, PRINT_FAILED.
  type      String
  fromState String?
  toState   String?
  /// Who caused it: customer, agent:<deviceId>, shop:<userId>, system, webhook.
  actor     String?
  detail    Json?

  createdAt DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([type, createdAt])
}

/// Request-level idempotency for money-moving and print-causing endpoints
/// (PRD 11). A replayed request with a matching key and payload returns the
/// stored response instead of executing again.
model IdempotencyRecord {
  key          String   @id
  /// Endpoint scope, so the same key on different operations cannot collide.
  scope        String
  /// Hash of the request payload, to detect a key reused with different content.
  requestHash  String
  statusCode   Int
  responseBody Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([scope, createdAt])
  @@index([expiresAt])
}

/// A paired Windows agent install (PRD 7.1, 7.2).
///
/// Credentials are device-scoped rather than shared: previously every agent
/// authenticated with the printer's own API key, so one compromised shop PC
/// could not be revoked without re-keying the printer and breaking every other
/// install. Only the SHA-256 of the token is stored — the plaintext is shown
/// once at pairing and never again.
model AgentDevice {
  id        String  @id
  printerId String
  printer   Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)

  deviceName   String?
  osVersion    String?
  agentVersion String?

  tokenHash      String    @unique
  tokenIssuedAt  DateTime  @default(now())
  tokenExpiresAt DateTime?

  /// active | revoked
  status        String    @default("active")
  revokedAt     DateTime?
  revokedReason String?

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([printerId, status])
  @@index([lastSeenAt])
}

/// Short-lived, single-use code that a merchant hands to a shop PC to pair it.
/// Bound to one printer and expired aggressively so a leaked code is near
/// worthless (PRD 7.1).
model AgentPairingCode {
  code           String    @id
  printerId      String
  expiresAt      DateTime
  usedAt         DateTime?
  usedByDeviceId String?
  createdAt      DateTime  @default(now())

  @@index([printerId, expiresAt])
}

/// Auditable agent security events (PRD 7.2). Kept separate from JobEvent
/// because these are not necessarily tied to a job.
model AgentSecurityEvent {
  id        String   @id @default(uuid())
  printerId String?
  deviceId  String?
  /// PAIRED | PAIRING_REJECTED | AUTH_REJECTED | LEGACY_KEY_USED | REVOKED | REPLAY_REJECTED
  type      String
  /// info | warning | critical
  severity  String   @default("info")
  detail    Json?
  createdAt DateTime @default(now())

  @@index([printerId, createdAt])
  @@index([type, createdAt])
}

/// Platform operator account (PRD 21).
///
/// Separate from shops: these are PrintOk staff who can see across the whole
/// network. Passwords are stored as scrypt hashes with a per-user salt, never
/// reversibly.
model AdminUser {
  id           String  @id
  email        String  @unique
  passwordHash String
  name         String?
  /// owner | admin | support - support is read-only (PRD 24).
  role         String  @default("admin")
  /// active | disabled
  status       String  @default("active")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([email])
}

/// Record of destructive or commercially significant operator actions (PRD 21, 22).
///
/// Deliberately not cascaded from the thing it describes: the whole point is to
/// survive the deletion of its target.
model AdminAuditLog {
  id         String   @id
  actorId    String
  actorEmail String
  /// SHOP_ARCHIVED | SHOP_RESTORED | SHOP_DELETED | PLAN_CHANGED
  action     String
  targetType String   @default("shop")
  targetId   String
  /// Snapshot of what was removed, so a deletion is explainable afterwards.
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

/// Enquiry submitted from the public contact form.
///
/// Stored rather than emailed so nothing depends on a mail provider being
/// configured, and so an enquiry cannot be silently lost. Notification can be
/// layered on later without changing how they are captured.
model ContactEnquiry {
  id       String  @id
  name     String
  email    String
  phone    String?
  shopName String?
  message  String

  /// new | read | replied | archived
  status String @default("new")
  /// Where it came from, e.g. "landing". Useful once there is more than one form.
  source String @default("landing")

  /// Coarse origin for abuse investigation. Hashed, never the raw address.
  ipHash    String?
  userAgent String?

  handledBy String?
  handledAt DateTime?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

/// A shop owner or staff member who signs in to the merchant dashboard.
///
/// Before this existed there was no merchant identity at all: the dashboard
/// trusted a shop id held in browser storage, and every /api/shops/:shopId
/// endpoint was unauthenticated — so anyone who knew a shop id could read that
/// shop's revenue and payout details, change its prices, or trigger a payout.
model MerchantUser {
  id     String @id
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  email        String  @unique
  passwordHash String
  name         String?
  phone        String?
  /// owner | staff — staff cannot change pricing or withdraw (PRD 20).
  role         String  @default("owner")
  /// active | disabled
  status       String  @default("active")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([shopId])
  @@index([email])
}

/// A webhook delivery we have already acted on, keyed by the gateway's own
/// event id.
///
/// Razorpay retries a delivery until it gets a 2xx, and it reuses the event id
/// when it does. Idempotency used to be inferred from the job's payment state
/// alone, which conflated two different questions: "have we seen this delivery"
/// and "is this job already paid". A refund landing between the original
/// delivery and its retry answered the second question with "no", so the retry
/// walked a refunded job back to Paid and it re-entered the revenue figures.
///
/// Recorded only after the signature is verified, so an unauthenticated caller
/// cannot fill this table or suppress a real delivery by guessing its id.
model WebhookEvent {
  /// The gateway's x-razorpay-event-id.
  eventId   String   @id
  /// payment.captured | order.paid | … Kept for auditing which deliveries ran.
  event     String
  jobId     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Hands out the next counter token for one printer on one day.
///
/// The token used to be derived from a COUNT of the day's jobs, read and then
/// used — with no transaction and no constraint. Two customers submitting at
/// the same printer in the same moment both read the same count and both got
/// #007, and the token is what a shop calls out to hand documents over, so the
/// wrong customer collects someone else's printout.
///
/// A row per printer per day, incremented atomically, so the number is
/// allocated by the database rather than inferred from it.
model PrinterDailyToken {
  printerId String
  /// YYYY-MM-DD.
  day       String
  /// The next token to hand out. Starts at 1.
  nextValue Int    @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@id([printerId, day])
}
