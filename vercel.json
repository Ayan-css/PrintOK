{
  "_comment": "Used when the Vercel project's Root Directory is the repository root; apps/customer-web/vercel.json covers the case where it is that folder. Keep both in step. Neither may declare `routes`: Vercel rejects `routes` alongside cleanUrls/trailingSlash/rewrites, which previously took the site down with a 403 on every path. There is deliberately NO catch-all rewrite to index.html — this is a multi-page static site, not an SPA, and an unmatched path must fall through to 404.html with a real 404 status rather than silently rendering the landing page.",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/apps/customer-web/public/index.html"
    },
    {
      "source": "/admin",
      "destination": "/apps/customer-web/public/admin.html"
    },
    {
      "source": "/register",
      "destination": "/apps/customer-web/public/register.html"
    },
    {
      "source": "/registration",
      "destination": "/apps/customer-web/public/register.html"
    },
    {
      "source": "/dashboard",
      "destination": "/apps/customer-web/public/dashboard.html"
    },
    {
      "source": "/print",
      "destination": "/apps/customer-web/public/print.html"
    },
    {
      "source": "/p/:printerId",
      "destination": "/apps/customer-web/public/print.html"
    },
    {
      "source": "/privacy",
      "destination": "/apps/customer-web/public/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/apps/customer-web/public/terms.html"
    },
    {
      "source": "/refund",
      "destination": "/apps/customer-web/public/refund.html"
    },
    {
      "source": "/404",
      "destination": "/apps/customer-web/public/404.html"
    },
    {
      "source": "/example",
      "destination": "/apps/customer-web/public/example.html"
    },
    {
      "source": "/(.*\\..*)",
      "destination": "/apps/customer-web/public/$1"
    }
  ]
}
