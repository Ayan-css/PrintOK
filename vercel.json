{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/apps/customer-web/public/index.html"
    },
    {
      "source": "/admin",
      "destination": "/apps/customer-web/public/admin.html"
    },
    {
      "source": "/register",
      "destination": "/apps/customer-web/public/register.html"
    },
    {
      "source": "/registration",
      "destination": "/apps/customer-web/public/register.html"
    },
    {
      "source": "/dashboard",
      "destination": "/apps/customer-web/public/dashboard.html"
    },
    {
      "source": "/print",
      "destination": "/apps/customer-web/public/print.html"
    },
    {
      "source": "/p/:printerId",
      "destination": "/apps/customer-web/public/print.html"
    },
    {
      "source": "/privacy",
      "destination": "/apps/customer-web/public/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/apps/customer-web/public/terms.html"
    },
    {
      "source": "/refund",
      "destination": "/apps/customer-web/public/refund.html"
    },
    {
      "source": "/404",
      "destination": "/apps/customer-web/public/404.html"
    },
    {
      "source": "/example",
      "destination": "/apps/customer-web/public/example.html"
    },
    {
      "source": "/(.*\\..*)",
      "destination": "/apps/customer-web/public/$1"
    }
  ]
}
