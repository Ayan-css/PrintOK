{
  "name": "printok-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Hardware-free stationery printing platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "echo \"Run specific app/service dev server\"",
    "build": "npm run build --workspace=@printok/shared-types && npm run build --workspace=@printok/api",
    "test": "npm test --workspace=@printok/api",
    "lint": "echo \"Running linter...\"",
    "graphify": "graphify ."
  },
  "keywords": [
    "printok",
    "printing",
    "windows-print-agent"
  ],
  "author": "PrintOk Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
