<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PrintOk.WindowsPrintAgent</RootNamespace>
    <UserSecretsId>dotnet-WindowsPrintAgent-12345</UserSecretsId>
    <Product>PrintOk Windows Print Agent</Product>
    <Company>PrintOk</Company>
    <Version>1.2.0</Version>
  </PropertyGroup>

  <!-- Published as a self-contained single file so a shop PC can run the agent
       without installing the .NET runtime first. appsettings.json is deliberately
       left beside the executable (not embedded) so merchants can drop in the
       config they download from the dashboard. -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <!-- DPAPI, for encrypting the device token at rest on Windows (PRD 7.2). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
