<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- The console host.
       Cross-platform, unattended, and the one the release workflow publishes as
       WindowsPrintAgent.exe. The desktop agent (PrintOk.Agent.Tray) is a second
       host over the same core; neither can break the other. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PrintOk.WindowsPrintAgent</RootNamespace>
    <UserSecretsId>dotnet-WindowsPrintAgent-12345</UserSecretsId>
    <Product>PrintOk Windows Print Agent</Product>
    <Company>PrintOk</Company>
    <Version>1.3.0</Version>
  </PropertyGroup>

  <!-- Published as a self-contained single file so a shop PC can run the agent
       without installing the .NET runtime first. appsettings.json is deliberately
       left beside the executable (not embedded) so merchants can drop in the
       config they download from the dashboard. -->

  <!-- Windows remains the default, so an unqualified publish produces exactly
       what it always did and the release workflow is unaffected. Passing
       -r linux-x64 now overrides it instead of being ignored, which is what
       lets the same agent be run and tested on a Linux machine. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == ''">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Deliberately no <RuntimeIdentifiers> list. With SelfContained=true, listing
       every RID makes restore download a full runtime pack for each one - roughly
       400 MB for a build that needs a single platform - which is slow everywhere
       and times out on a weak connection. Passing -r on the command line
       overrides the default above, so the list bought nothing. -->

  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../PrintOk.Agent.Core/PrintOk.Agent.Core.csproj" />
  </ItemGroup>

</Project>
